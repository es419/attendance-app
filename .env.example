# Required for Google OAuth / Drive / Sheets (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a long random value. Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional. If empty, the app derives it from the current host.
# Local example: http://localhost:3000/api/auth/google/callback
# Vercel example: https://your-app.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Optional: use an existing Drive folder as the app root.
# If empty, the app finds/creates a root folder called "נוכחות בעבודה".
GOOGLE_DRIVE_ROOT_FOLDER_ID=
